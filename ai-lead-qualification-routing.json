    {
      "parameters": {
        "jsCode": "const lead = $json.output ?? $json;\n\nlet score = 0;\n\n// Budget scoring\nif (Number(lead.budget) >= 1000) score += 3;\nelse if (Number(lead.budget) >= 500) score += 2;\nelse score += 1;\n\n// Urgency scoring\nif (lead.urgency === \"High\") score += 3;\nelse if (lead.urgency === \"Medium\") score += 2;\nelse score += 1;\n\n// AI priority scoring\nif (lead.priority === \"Hot\") score += 3;\nelse if (lead.priority === \"Warm\") score += 2;\nelse score += 1;\n\n// Final classification\nlet finalPriority = \"Cold\";\n\nif (score >= 8) finalPriority = \"Hot\";\nelse if (score >= 5) finalPriority = \"Warm\";\n\nreturn [\n  {\n    json: {\n      ...lead,\n      score,\n      finalPriority\n    }\n  }\n];"
      },
