    {
      "parameters": {
        "promptType": "define",
        "text": "=Return ONLY valid JSON. Do not include explanations or text outside JSON.\nAnalyze this lead and return ONLY valid JSON:\n\n{\n  \"priority\": \"Hot | Warm | Cold\",\n  \"budget\": number,\n  \"urgency\": \"High | Medium | Low\",\n  \"summary\": \"short explanation\"\n}\n\nLead details:\n\nName: {{ $json[\"Name\"] }}\nEmail: {{ $json[\"Email\"] }}\nCompany: {{ $json[\"Company Name\"] }}\nRequest: {{ $json[\"What do you want to automate?\"] }}\nBudget: {{ $json[\"Budget Range\"] }}\nTimeline: {{ $json[\"Timeline\"] }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a helpful assiYou are analyzing a new business lead.\n\nRead the lead details and classify the lead based on urgency, budget, and overall sales potential.\n\nReturn ONLY valid JSON in this exact format:\n\n{\n  \"priority\": \"Hot\",\n  \"budget\": 0,\n  \"urgency\": \"High\",\n  \"summary\": \"short explanation\"\n}\n\nRules:\n- priority must be exactly one of: Hot, Warm, Cold\n- urgency must be exactly one of: High, Medium, Low\n- budget must be a number only\n- summary must be a short one-sentence explanation\n- do not return markdown\n- do not use code fences\n- do not add extra text before or after the JSON\n\nBudget conversion rules:\n- If budget says \"Under $500\", return 300\n- If budget says \"$500 - $1,000\", return 750\n- If budget says \"$1,000 - $2,000\", return 1500\n- If budget says \"$2,000+\", return 2000\n\nUrgency rules:\n- If timeline suggests immediate or urgent need, urgency = High\n- If timeline suggests soon but not immediate, urgency = Medium\n- If timeline suggests flexible or no urgency, urgency = Low\n\nPriority rules:\n- Hot = clear business need + strong budget + urgent timeline\n- Warm = moderate budget or moderate urgency\n- Cold = low budget, vague need, or low urgencystant"
        }
      },
